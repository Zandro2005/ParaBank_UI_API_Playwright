{
  "name": "parabank-api-ui-playwright",
  "version": "1.0.0",
  "description": "ParaBank API + UI + Hybrid End-to-End Automation Framework using Playwright & TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:hybrid": "playwright test tests/hybrid",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "generate:pdf": "node scripts/generatePdf.js"
  },
  "keywords": [
    "playwright",
    "typescript",
    "api-testing",
    "ui-testing",
    "hybrid-testing",
    "parabank",
    "e2e",
    "qa-automation",
    "portfolio"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "dotenv": "^16.4.7",
    "marked": "^18.1.1",
    "typescript": "^5.7.3"
  }
}
